{
  "name": "sculpt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test": "vitest run",
    "backend:setup": "python3 backend/setup_runtime.py",
    "backend:test": ".sculpt-runtime/venv/bin/python -m pytest backend/tests -q",
    "backend:generate": ".sculpt-runtime/venv/bin/python backend/generate.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.577.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
