{
  "name": "sculpt",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "dev:local": "node scripts/runner.js vite --host 127.0.0.1 --port 1420 --strictPort --config vite.config.local.ts",
    "build:local": "tsc -b && node scripts/runner.js vite build --config vite.config.local.ts",
    "preview:local": "node scripts/runner.js vite preview --host 127.0.0.1 --port 1420 --config vite.config.local.ts",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:verify": "node scripts/verify-desktop-bundle.mjs",
    "desktop:verify:macos": "node scripts/verify-macos-bundle.mjs",
    "desktop:verify:macos-arm64": "node scripts/verify-macos-bundle.mjs --target aarch64-apple-darwin --expected-arch arm64",
    "desktop:verify:windows": "node scripts/verify-windows-bundle.mjs",
    "desktop:verify:windows-x64": "node scripts/verify-windows-bundle.mjs --target x86_64-pc-windows-msvc --expected-arch x64",
    "desktop:verify:windows-arm64": "node scripts/verify-windows-bundle.mjs --target aarch64-pc-windows-msvc --expected-arch arm64",
    "desktop:verify:linux": "node scripts/verify-linux-bundle.mjs",
    "desktop:verify:linux-x64": "node scripts/verify-linux-bundle.mjs --target x86_64-unknown-linux-gnu --expected-arch x64",
    "ci:hygiene": "node scripts/verify-ci-hygiene.mjs --check-repo",
    "test": "vitest run",
    "test:ui": "playwright test",
    "backend:setup": "node scripts/run-python.mjs system backend/setup_runtime.py",
    "backend:test": "node scripts/run-python.mjs venv -m pytest backend/tests -q",
    "backend:generate": "node scripts/run-python.mjs venv backend/generate.py",
    "backend:benchmark": "node scripts/run-python.mjs venv backend/benchmark.py",
    "backend:benchmark-texture": "node scripts/run-python.mjs venv backend/benchmark_texture.py",
    "backend:eval": "node scripts/run-python.mjs venv backend/evaluate.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.577.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "4.1.11"
  }
}
